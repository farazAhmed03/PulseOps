PORT=5000
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@pulseops.io
ADMIN_PASSWORD=adminpassword123

# MongoDB Authentication
MONGO_INITDB_ROOT_USERNAME=db_admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_password_here

# Mongo-Express Web GUI Credentials
ME_CONFIG_BASICAUTH_USERNAME=express_admin
ME_CONFIG_BASICAUTH_PASSWORD=express_password123

# Database Connection URLs (Used inside Docker bridge network)
MONGO_URI=mongodb://db_admin:your_secure_password_here@mongodb:27017/pulseops_db?authSource=admin
ME_CONFIG_MONGODB_URL=mongodb://db_admin:your_secure_password_here@mongodb:27017/?authSource=admin
